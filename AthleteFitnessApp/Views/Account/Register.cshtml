@model AthleteFitnessApp.Models.RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="container mt-5" style="max-width: 450px;">
    <div class="text-center mb-4">
        <h2 class="fw-bold mb-3">Join <span class="text-primary">Athlete Fitness</span></h2>
        <p class="text-muted">Create an account to start tracking</p>
    </div>
    <div class="card p-5 border-0 shadow-lg" style="background: rgba(255,255,255,0.02); backdrop-filter: blur(10px);">
        <form asp-action="Register" method="post">
            <div class="mb-4">
                <label class="form-label text-muted fw-bold">Username</label>
                <input asp-for="Username" class="form-control form-control-lg bg-dark text-white border-secondary" required />
            </div>
            <div class="mb-4">
                <label class="form-label text-muted fw-bold">Email</label>
                <input asp-for="Email" class="form-control form-control-lg bg-dark text-white border-secondary" required />
            </div>
            <div class="mb-4">
                <label class="form-label text-muted fw-bold">Password</label>
                <input asp-for="Password" type="password" class="form-control form-control-lg bg-dark text-white border-secondary" required />
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 mt-2">Sign Up</button>
        </form>
        <div class="text-center mt-4">
            <p class="text-muted mb-0">Already have an account? <a asp-action="Login" class="text-primary text-decoration-none">Sign In</a></p>
        </div>
    </div>
</div>